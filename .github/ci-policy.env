CI=INAPPLICABLE
CI_REASON=repository defines a reusable workflow that runs only when called and has no standalone CI workflow
CI_EVIDENCE=test "$(git ls-files .github/workflows)" = .github/workflows/repo-agent-config.yml && ruby -ryaml -e 'abort unless YAML.load_file(ARGV.fetch(0)).fetch(true).keys == ["workflow_call"]' .github/workflows/repo-agent-config.yml
